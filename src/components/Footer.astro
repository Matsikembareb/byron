---
import { PROFILE, FOOTER } from '../data.ts';
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="wrap pt-16 lg:pt-24 pb-10">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[348px_1fr_1fr_1fr] lg:gap-16">
      <div>
        <p class="text-[22px] leading-none font-semibold text-ink">byron<span class="text-accent">.</span></p>
        <p class="mt-4 text-[15px] leading-[1.65] text-muted max-w-[340px]">{FOOTER.blurb}</p>
      </div>

      <div>
        <h2 class="text-[16px] font-medium text-ink">Pages</h2>
        <ul class="mt-4 space-y-3">
          {FOOTER.pages.map((l) => (
            <li><a href={l.href} class="text-[15px] text-muted hover:text-ink transition-colors">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-[16px] font-medium text-ink">Connect</h2>
        <ul class="mt-4 space-y-3">
          <li><a href={PROFILE.social.github} target="_blank" rel="noopener noreferrer me" class="text-[15px] text-muted hover:text-ink transition-colors">GitHub</a></li>
          <li><a href={PROFILE.social.linkedin} target="_blank" rel="noopener noreferrer me" class="text-[15px] text-muted hover:text-ink transition-colors">LinkedIn</a></li>
          <li><a href="/references" class="text-[15px] text-muted hover:text-ink transition-colors">References</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-[16px] font-medium text-ink">Contact</h2>
        <ul class="mt-4 space-y-3">
          <li><a href={PROFILE.social.email} class="text-[15px] text-muted hover:text-ink transition-colors break-all">{PROFILE.email}</a></li>
          {PROFILE.showPhone && PROFILE.phone && (
            <li><a href={`tel:${PROFILE.phone.replace(/\s/g, '')}`} class="text-[15px] text-muted hover:text-ink transition-colors">{PROFILE.phone}</a></li>
          )}
          <li class="text-[15px] text-muted">{PROFILE.location}</li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-line flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between text-[14px] text-muted">
      <p>&copy; {year} {PROFILE.name}. All rights reserved.</p>
      <p>Built with Astro</p>
    </div>
  </div>
</footer>
