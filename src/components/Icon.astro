---
// Lucide icons (lucide-static, ISC), inlined at build time with the design's 1.5px stroke.
// No runtime JavaScript. Add an icon by importing its SVG with ?raw and listing it below.
import arrowDown from 'lucide-static/icons/arrow-down.svg?raw';
import arrowRight from 'lucide-static/icons/arrow-right.svg?raw';
import arrowUpRight from 'lucide-static/icons/arrow-up-right.svg?raw';
import braces from 'lucide-static/icons/braces.svg?raw';
import code from 'lucide-static/icons/code.svg?raw';
import codeXml from 'lucide-static/icons/code-xml.svg?raw';
import database from 'lucide-static/icons/database.svg?raw';
import download from 'lucide-static/icons/download.svg?raw';
import github from 'lucide-static/icons/github.svg?raw';
import layers from 'lucide-static/icons/layers.svg?raw';
import linkedin from 'lucide-static/icons/linkedin.svg?raw';
import mail from 'lucide-static/icons/mail.svg?raw';
import mapPin from 'lucide-static/icons/map-pin.svg?raw';
import menu from 'lucide-static/icons/menu.svg?raw';
import messageCircle from 'lucide-static/icons/message-circle.svg?raw';
import monitor from 'lucide-static/icons/monitor.svg?raw';
import moon from 'lucide-static/icons/moon.svg?raw';
import sun from 'lucide-static/icons/sun.svg?raw';
import x from 'lucide-static/icons/x.svg?raw';
import blocks from 'lucide-static/icons/blocks.svg?raw';
import calendarHeart from 'lucide-static/icons/calendar-heart.svg?raw';
import globe from 'lucide-static/icons/globe.svg?raw';
import heart from 'lucide-static/icons/heart.svg?raw';
import graduationCap from 'lucide-static/icons/graduation-cap.svg?raw';
import handshake from 'lucide-static/icons/handshake.svg?raw';
import lifeBuoy from 'lucide-static/icons/life-buoy.svg?raw';
import lightbulb from 'lucide-static/icons/lightbulb.svg?raw';
import share2 from 'lucide-static/icons/share-2.svg?raw';

const ICONS = {
  'arrow-down': arrowDown,
  'arrow-right': arrowRight,
  'arrow-up-right': arrowUpRight,
  braces,
  code,
  'code-xml': codeXml,
  database,
  download,
  github,
  layers,
  linkedin,
  mail,
  'map-pin': mapPin,
  menu,
  'message-circle': messageCircle,
  monitor,
  moon,
  sun,
  x,
  blocks,
  'calendar-heart': calendarHeart,
  globe,
  heart,
  'graduation-cap': graduationCap,
  handshake,
  'life-buoy': lifeBuoy,
  lightbulb,
  'share-2': share2,
} as const;

export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  size?: number;
  stroke?: number;
  class?: string;
  /** Give an accessible name only when the icon carries meaning on its own. */
  label?: string;
}

const { name, size = 20, stroke = 1.5, class: klass, label } = Astro.props;
const inner = ICONS[name]
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/^[\s\S]*?<svg[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '')
  .trim();
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['lucide', klass]}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={inner}
/>
