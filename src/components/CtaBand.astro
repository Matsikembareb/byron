---
// Full-width accent band: "Let's build something useful together." + "contact me →".
import Icon from './Icon.astro';
import { HOME } from '../data.ts';

interface Props {
  heading?: string;
  body?: string;
}
const { heading = HOME.cta.heading, body = HOME.cta.body } = Astro.props;
---

<section class="bg-accent-fill text-on-accent">
  <div class="wrap py-16 lg:py-24 flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
    <div class="max-w-[700px]">
      <h2 class="text-[32px] md:text-[44px] leading-[1.2] font-medium">{heading}</h2>
      <p class="mt-3 text-[16px] font-light">{body}</p>
    </div>
    <a
      href="/contact"
      class="inline-flex items-center gap-2.5 self-start lg:self-auto rounded bg-bg text-ink px-7 py-4 text-[16px] font-normal lowercase hover:opacity-90 transition-opacity"
    >
      contact me
      <Icon name="arrow-right" size={16} />
    </a>
  </div>
</section>
