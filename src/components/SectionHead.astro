---
// Eyebrow label above a section heading. Centred or left-aligned, with an optional
// lowercase "all projects →" style link on the right (left-aligned variant only).
import Icon from './Icon.astro';

interface Props {
  eyebrow: string;
  heading: string;
  align?: 'center' | 'left';
  link?: { href: string; label: string };
  /** Heading level; defaults to h2. */
  as?: 'h1' | 'h2';
  maxWidth?: string;
}
const { eyebrow, heading, align = 'left', link, as: Tag = 'h2', maxWidth = '640px' } = Astro.props;
---

{
  align === 'center' ? (
    <div class="text-center mx-auto" style={`max-width:${maxWidth}`}>
      <p class="eyebrow">{eyebrow}</p>
      <Tag class="h-section mt-4">{heading}</Tag>
    </div>
  ) : (
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div style={`max-width:${maxWidth}`}>
        <p class="eyebrow">{eyebrow}</p>
        <Tag class="h-section mt-4">{heading}</Tag>
      </div>
      {link && (
        <a href={link.href} class="link-arrow shrink-0 md:mb-2">
          {link.label}
          <Icon name="arrow-right" size={14} />
        </a>
      )}
    </div>
  )
}
