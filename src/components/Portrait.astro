---
import { PROFILE } from '../data.ts';

interface Props {
  class?: string;
  eager?: boolean;
}
const { class: klass = '', eager = false } = Astro.props;
---

{
  PROFILE.portrait ? (
    <img
      src={PROFILE.portrait}
      alt={PROFILE.portraitAlt}
      width="415"
      height="533"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class:list={['rounded object-cover bg-surface', klass]}
    />
  ) : (
    /* No headshot supplied yet. A monogram is honest; a stock photo of a
       stranger is not. Set PROFILE.portrait in data.ts to replace this. */
    <div
      class:list={['rounded bg-surface flex flex-col items-center justify-center gap-3', klass]}
      role="img"
      aria-label={PROFILE.portraitAlt}
    >
      <span class="text-6xl font-semibold text-ink">{PROFILE.initials}<span class="text-accent">.</span></span>
      <span class="eyebrow">Harare, Zimbabwe</span>
    </div>
  )
}
