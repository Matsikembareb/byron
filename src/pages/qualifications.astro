---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { EDUCATION, CERTIFICATIONS, SKILLS, PEOPLE_SKILLS } from '../data.ts';
---

<Base
  metaTitle="Qualifications & Certifications – Byron Matsikembare"
  description="BTech (Hons) Computer Science at Harare Institute of Technology, 21 A-Level points, 8 As at O-Level, plus Master.dev, HEXCO and POTRAZ certificates."
>
  <PageHeader
    eyebrow="Credentials"
    title="Qualifications and certifications"
    subtitle="I'm a HIT Computer Science student working towards a BTech (Honours), graduating in 2027. Before HIT: 21 A-Level points and 15 O-Level passes (8 As, 7 Bs)."
  />

  <!-- Education -->
  <section class="wrap pb-16 lg:pb-24" aria-labelledby="edu-h">
    <h2 id="edu-h" class="eyebrow">Education</h2>
    <ol class="mt-6 border-t border-line">
      {EDUCATION.map((e) => (
        <li class="grid md:grid-cols-[220px_1fr] gap-x-10 gap-y-2 py-8 border-b border-line">
          <p class="text-[15px] text-muted">{e.dates}</p>
          <div>
            <h3 class="text-[22px] font-normal text-ink">
              {e.qualification}
              {e.current && <span class="ml-2 align-middle inline-flex items-center gap-1.5 text-[13px] text-ink"><span class="w-1.5 h-1.5 rounded-full bg-[var(--ok)]" aria-hidden="true"></span>In progress</span>}
            </h3>
            <p class="mt-1 text-[15px] text-muted">{e.institution}, {e.location}</p>
            {'highlight' in e && e.highlight && <a href={e.highlight.href} class="link-arrow mt-3">{e.highlight.label} <Icon name="arrow-right" size={14} /></a>}
            {e.result !== 'In progress' && <p class="mt-3 text-[16px] leading-[1.7] text-ink max-w-[760px]">{e.result}</p>}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Certifications -->
  <section class="wrap pb-16 lg:pb-24" aria-labelledby="cert-h">
    <h2 id="cert-h" class="eyebrow">Certifications and training</h2>
    <ul class="mt-6 border-t border-line">
      {CERTIFICATIONS.map((c) => (
        <li class="grid md:grid-cols-[220px_1fr] gap-x-10 gap-y-2 py-7 border-b border-line">
          <p class="text-[15px] text-muted">{c.year || c.issuer}</p>
          <div>
            <h3 class="text-[19px] font-normal text-ink">{c.title}</h3>
            <p class="mt-1 text-[15px] text-muted">{c.issuer} · {c.focus}</p>
            {c.courses && (
              <ul class="mt-5 grid sm:grid-cols-2 gap-x-10 gap-y-3">
                {c.courses.map((course) => (
                  <li class="text-[14px] leading-[1.5]">
                    <span class="text-ink">{course.name}</span>
                    <span class="block text-muted">{course.date} · <span class="tabular-nums">{course.id}</span></span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- Technical skills: plain lists, never percentage bars -->
  <section class="bg-surface" aria-labelledby="skills-h">
    <div class="wrap py-16 lg:py-24">
      <p class="eyebrow">Skills</p>
      <h2 id="skills-h" class="h-section mt-4">Technical skills</h2>
      <p class="mt-4 text-[15px] text-muted">Plain lists, not percentage bars: nobody can check what "90% Python" means.</p>
      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 border-l border-t border-line">
        {SKILLS.map((group) => (
          <div class="border-r border-b border-line p-7">
            <h3 class="text-[17px] font-normal text-ink">{group.area}</h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="text-[13px] text-ink border border-line rounded px-2.5 py-1 bg-bg">{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Languages and people skills -->
  <section class="wrap py-16 lg:py-24" aria-labelledby="people-h">
    <h2 id="people-h" class="eyebrow">Languages and people skills</h2>
    <ul class="mt-6 border-t border-line">
      {PEOPLE_SKILLS.map((s) => (
        <li class="py-5 border-b border-line text-[17px] text-ink">{s}</li>
      ))}
    </ul>
  </section>

  <CtaBand />
</Base>
