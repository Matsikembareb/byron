---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found" noindex={true} description="The page you're looking for doesn't exist.">
  <section class="wrap pt-20 lg:pt-32 pb-28 lg:pb-40">
    <p class="eyebrow">404</p>
    <h1 class="h-section mt-4">Page not found</h1>
    <p class="mt-5 text-[18px] text-muted">That page doesn't exist or has moved.</p>
    <a href="/" class="btn btn-primary mt-9">Back home <Icon name="arrow-right" size={16} /></a>
  </section>
</Base>
