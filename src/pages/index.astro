---
// Homepage — Figma frames 9:77 (light) / 9:351 (dark), WEBSITE_VISION.md §3.
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import WorkTile from '../components/WorkTile.astro';
import LiveTile from '../components/LiveTile.astro';
import PostCard from '../components/PostCard.astro';
import Stats from '../components/Stats.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../config.ts';
import { HOME, PROJECTS, LIVE_SYSTEMS, EXPERIENCE, LEADERSHIP, REFEREES, yearRange } from '../data.ts';
import { getPublishedPosts } from '../lib/blog.ts';

const bySlug = (slug: string) => PROJECTS.find((p) => p.slug === slug)!;
const selected = HOME.selected.map(bySlug);
const hasCv = fs.existsSync(path.join(process.cwd(), 'public', HOME.cvPath));
const posts = (await getPublishedPosts()).slice(0, 3);
const quoted = REFEREES.find((r) => r.quote);

// Experience rows: the three jobs, then the CoDe chair — the design's four rows.
const code = LEADERSHIP.find((l) => l.org.startsWith('CoDe'));
const rows = [
  ...EXPERIENCE.map((r) => ({ when: yearRange(r.period), role: r.title, org: r.org })),
  ...(code ? [{ when: yearRange(code.period), role: code.role, org: code.org }] : []),
];
---

<Base metaTitle={SITE.title} description={SITE.description}>
  <!-- Hero -->
  <section class="wrap pt-14 pb-16 lg:pt-[112px] lg:pb-[88px]">
    <div class="relative lg:pl-[70px]">
      <Icon name="arrow-down" size={22} class="hidden lg:block absolute left-0 top-8 text-muted" />
      <!-- One H1 holding the name and the pitch, so a search for the name lands here first. -->
      <h1>
        <span class="eyebrow block">{HOME.eyebrow}</span>
        <span class="block mt-6 lg:mt-9 max-w-[1020px] text-[40px] leading-[1.18] sm:text-[52px] lg:text-[64px] font-normal tracking-[-0.01em] text-ink">
          {HOME.headline}{' '}
          <span class="text-accent underline decoration-[3px] underline-offset-[6px] lg:underline-offset-[10px]">{HOME.headlineEmphasis}</span>.
        </span>
      </h1>
      <p class="mt-6 max-w-[640px] text-[17px] leading-[1.7] text-muted">{HOME.currentRole}</p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a href="/contact" class="inline-flex items-center gap-2.5 rounded bg-surface px-4 py-2.5 text-[14px] text-ink hover:text-accent transition-colors">
          <span class="w-2 h-2 rounded-full bg-[var(--ok)]" aria-hidden="true"></span>
          {HOME.availability}
          <Icon name="arrow-right" size={14} />
        </a>
        {hasCv && (
          <a href={HOME.cvPath} class="btn btn-outline" download>Download CV</a>
        )}
      </div>
    </div>
  </section>

  <!-- Live systems strip (full width): each tile opens the real site -->
  <section aria-labelledby="live-h">
    <div class="wrap mb-6 flex items-end justify-between gap-6">
      <h2 id="live-h" class="eyebrow">{HOME.live.eyebrow}</h2>
      <a href="/projects#live" class="link-arrow">about them <Icon name="arrow-right" size={14} /></a>
    </div>
    <ul class="px-4 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {LIVE_SYSTEMS.map((s) => <li><LiveTile system={s} /></li>)}
    </ul>
  </section>

  <!-- Services -->
  <section class="wrap section">
    <SectionHead eyebrow={HOME.services.eyebrow} heading={HOME.services.heading} align="center" maxWidth="720px" />
    <ul class="mt-12 lg:mt-16 grid sm:grid-cols-2 lg:grid-cols-4 border-l border-t border-line">
      {HOME.services.items.map((s) => (
        <li class="flex flex-col items-center text-center border-r border-b border-line px-8 py-10 lg:min-h-[250px]">
          <Icon name={s.icon} size={40} class="text-ink" />
          <h3 class="mt-5 text-[18px] lg:text-[20px] font-normal text-ink">{s.h}</h3>
          <p class="mt-3 text-[14px] leading-[1.7] text-muted max-w-[230px]">{s.body}</p>
        </li>
      ))}
    </ul>
    <p class="mt-10 text-center">
      <a href="/services" class="link-arrow">how I work, what I build and how to hire me <Icon name="arrow-right" size={14} /></a>
    </p>
  </section>

  <!-- Selected work -->
  <section class="wrap pb-20 lg:pb-32">
    <SectionHead eyebrow={HOME.work.eyebrow} heading={HOME.work.heading} link={{ href: '/projects', label: 'all projects' }} />
    <div class="mt-12 lg:mt-16 grid md:grid-cols-2 gap-x-10 gap-y-14 lg:gap-y-16">
      {selected.map((p) => <WorkTile project={p} />)}
    </div>
  </section>

  <Stats />

  <!-- Experience -->
  <section class="wrap section">
    <SectionHead eyebrow={HOME.experience.eyebrow} heading={HOME.experience.heading} link={{ href: '/experience', label: 'full experience' }} />
    <ul class="mt-12 lg:mt-16 border-t border-line">
      {rows.map((r) => (
        <li class="border-b border-line">
          <a href="/experience" class="group grid grid-cols-[1fr_auto] md:grid-cols-[180px_1fr_300px_22px] items-center gap-x-10 gap-y-1 py-6 md:py-8">
            <span class="order-2 md:order-none col-span-2 md:col-span-1 text-[14px] md:text-[15px] text-muted">{r.when}</span>
            <span class="order-1 md:order-none text-[20px] md:text-[24px] font-normal text-ink group-hover:text-accent transition-colors">{r.role}</span>
            <span class="order-3 md:order-none col-span-2 md:col-span-1 text-[14px] md:text-[15px] text-muted">{r.org}</span>
            <Icon name="arrow-up-right" size={22} class="order-1 md:order-none text-ink justify-self-end" />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- References: hidden until a referee has given a real quote with permission. -->
  {quoted && (
    <section class="bg-surface">
      <div class="wrap py-20 lg:py-28 text-center">
        <p class="eyebrow">References</p>
        <p class="mt-6 text-[48px] leading-none text-accent font-medium" aria-hidden="true">“</p>
        <blockquote class="mt-4 mx-auto max-w-[860px] text-[22px] md:text-[26px] leading-[1.55] font-light text-ink">{quoted.quote}</blockquote>
        <p class="mt-7 text-[15px] text-muted">{quoted.name} · {quoted.role}</p>
      </div>
    </section>
  )}

  <!-- Recent blog -->
  <section class="wrap section">
    <SectionHead eyebrow={HOME.blog.eyebrow} heading={HOME.blog.heading} align="center" maxWidth="720px" />
    <div class="mt-12 lg:mt-16 grid md:grid-cols-3 gap-10">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <CtaBand />
</Base>
