---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PostTitle from '../../components/PostTitle.astro';
import CtaBand from '../../components/CtaBand.astro';
import LinkedInPost from '../../components/LinkedInPost.astro';
import { PROJECTS, PROFILE } from '../../data.ts';
import { getPublishedPosts } from '../../lib/blog.ts';
import { DONATE_URL, SITE_URL } from '../../config.ts';
import { LINKEDIN_POSTS } from '../../data/linkedin.ts';

export function getStaticPaths() {
  return PROJECTS.filter((p) => p.caseStudy).map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const related = (await getPublishedPosts()).find((p) => p.slug === project.relatedPost);
const liPost = LINKEDIN_POSTS.find((e) => e.project === project.slug);

// Before/after art lives in src/assets/<slug>/without.svg and with.svg, inlined so it follows the theme.
const art = import.meta.glob<string>('../../assets/*/{without,with}.svg', { query: '?raw', import: 'default', eager: true });
const artFor = (side: 'without' | 'with') => art[`../../assets/${project.slug}/${side}.svg`];
const beforeAfter = project.beforeAfter && artFor('without') && artFor('with')
  ? [
      { side: 'without' as const, title: `Without ${project.title}`, points: project.beforeAfter.without },
      { side: 'with' as const, title: `With ${project.title}`, points: project.beforeAfter.with },
    ]
  : [];

const facts = [
  { label: 'Status', value: project.status },
  { label: 'When', value: project.period },
  { label: 'Role', value: project.role },
  { label: 'Stack', value: project.stack.join(' · ') },
].filter((f) => f.value);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  headline: project.h1,
  description: project.metaDescription,
  url: new URL(`/projects/${project.slug}`, SITE_URL).href,
  keywords: project.stack.join(', '),
  ...(project.image || project.logo ? { image: new URL((project.image ?? project.logo)!, SITE_URL).href } : {}),
  ...(project.repo ? { codeRepository: project.repo } : {}),
  creator: { '@id': `${SITE_URL.replace(/\/$/, '')}/#person` },
  author: { '@type': 'Person', name: PROFILE.name },
};
---

<Base metaTitle={project.metaTitle} description={project.metaDescription} jsonld={schema}>
  <article>
    <header class="wrap pt-10 lg:pt-16">
      <a href="/projects" class="link-arrow"><Icon name="arrow-right" size={14} class="rotate-180" /> all projects</a>
      <div class="mt-10 max-w-[900px]">
        {project.logo && <img src={project.logo} alt={`${project.title} logo`} width="64" height="64" class="w-16 h-16 mb-6 rounded-[14px]" />}
        <p class="eyebrow">{[project.status, project.period].filter(Boolean).join(' · ')}</p>
        <h1 class="h-section mt-4">{project.h1}</h1>
        <p class="mt-5 text-[18px] leading-[1.65] text-muted">{project.tagline}</p>
        {(project.url || project.repo) && (
          <div class="mt-8 flex flex-wrap gap-3">
            {project.url && <a href={project.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Visit live site <Icon name="arrow-up-right" size={16} /></a>}
            {project.repo && <a href={project.repo} target="_blank" rel="noopener noreferrer" class="btn btn-outline">{project.repoLabel ?? 'View the code'} <Icon name="arrow-up-right" size={16} /></a>}
            {project.donate && DONATE_URL && <a href={DONATE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-outline"><Icon name="heart" size={16} /> Sponsor</a>}
          </div>
        )}
      </div>
    </header>

    <div class="wrap mt-12">
      {project.image ? (
        <img
          src={project.image}
          srcset={`${project.image.replace(/\.webp$/, '-600.webp')} 600w, ${project.image} 1200w`}
          sizes="(min-width: 1280px) 1200px, 100vw"
          alt={project.imageAlt ?? ''}
          width="1200"
          height="750"
          fetchpriority="high"
          class="w-full rounded border border-line bg-surface"
        />
      ) : (
        <div class="flex items-end gap-6 h-[200px] md:h-[320px] p-6 md:p-10 rounded" style={`background:${project.accent}`} aria-hidden="true">
          {project.logo && <img src={project.logo} alt="" width="96" height="96" class="w-16 h-16 md:w-24 md:h-24 rounded-[18px] ring-2 ring-white/25" />}
          <span class:list={['text-[32px] md:text-[56px] leading-none font-medium', project.tileDarkText ? 'text-[#111214]' : 'text-white']}>{project.tileTitle ?? project.title}</span>
        </div>
      )}
    </div>

    <div class="wrap py-14 lg:py-20 grid lg:grid-cols-[300px_minmax(0,1fr)] gap-12 lg:gap-24 items-start">
      <dl class="border-t border-line lg:sticky lg:top-32">
        {facts.map((f) => (
          <div class="py-4 border-b border-line">
            <dt class="eyebrow">{f.label}</dt>
            <dd class="mt-1.5 text-[15px] text-ink">{f.value}</dd>
          </div>
        ))}
      </dl>

      <div>
        <div class="article">
          {project.blocks.map((b) => (
            <>
              <h2>{b.h}</h2>
              <p>{b.body}</p>
            </>
          ))}
        </div>

        {beforeAfter.length > 0 && (
          <section class="mt-14" aria-labelledby="ba-h">
            <h2 id="ba-h" class="eyebrow">Before and after</h2>
            <div class="mt-6 grid sm:grid-cols-2 gap-8">
              {beforeAfter.map((b) => (
                <figure>
                  <div class="illustration rounded border border-line overflow-hidden" set:html={artFor(b.side)} />
                  <figcaption class="mt-5">
                    <p class="text-[18px] text-ink">{b.title}</p>
                    <ul class="mt-3 space-y-2">
                      {b.points.map((pt) => (
                        <li class="flex gap-3 text-[15px] leading-[1.6] text-muted">
                          <span class:list={['mt-[9px] w-1.5 h-1.5 shrink-0 rounded-full', b.side === 'with' ? 'bg-[#0f766e]' : 'bg-[#ef4444]']} aria-hidden="true"></span>
                          {pt}
                        </li>
                      ))}
                    </ul>
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )}

        {project.gallery && project.gallery.length > 0 && (
          <section class="mt-14" aria-labelledby="screens-h">
            <h2 id="screens-h" class="eyebrow">Screens</h2>
            <div class="mt-6 grid gap-10">
              {project.gallery.map((g) => (
                <figure>
                  <img src={g.src} alt={g.alt} width="1200" height="750" loading="lazy" decoding="async" class="w-full rounded border border-line bg-surface" />
                  <figcaption class="mt-3 text-[14px] leading-[1.6] text-muted">{g.caption}</figcaption>
                </figure>
              ))}
            </div>
          </section>
        )}

        {project.donate && DONATE_URL && (
          <section class="mt-14 rounded border border-line p-7 md:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-6" aria-labelledby="support-h">
            <div class="max-w-[520px]">
              <h2 id="support-h" class="text-[22px] font-normal text-ink">Support {project.title}</h2>
              <p class="mt-2 text-[15px] leading-[1.7] text-muted">
                It's free and open source. If it saved you an afternoon of setup, you can chip in to help me keep it maintained.
              </p>
            </div>
            <a href={DONATE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary shrink-0 self-start md:self-auto">
              <Icon name="heart" size={16} /> Sponsor on GitHub
            </a>
          </section>
        )}

        {liPost && (
          <div class="mt-14">
            <h2 class="eyebrow">Shared on LinkedIn</h2>
            <div class="mt-5"><LinkedInPost embed={liPost.embed} title={liPost.title} height={liPost.height} url={liPost.url} /></div>
          </div>
        )}

        <div class="mt-14 pt-8 border-t border-line max-w-prose space-y-3">
          {related && (
            <p class="text-[15px] text-muted">
              Related post:
              <a href={`/blog/${related.slug}`} class="link-arrow ml-1 text-[15px] normal-case"><PostTitle text={related.data.title} /> <Icon name="arrow-right" size={14} /></a>
            </p>
          )}
          <p>
            <a href="/projects" class="link-arrow">all projects <Icon name="arrow-right" size={14} /></a>
          </p>
        </div>
      </div>
    </div>
  </article>

  <CtaBand heading="Want something like this built?" body="Have a role, an internship or a web project in mind? I’d love to hear about it." />
</Base>
