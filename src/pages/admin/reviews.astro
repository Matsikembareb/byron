---
// /admin/reviews: Byron approves or rejects reviews sent from /review, and can take approved ones
// down again. Password from REVIEWS_ADMIN_PASSWORD (src/lib/admin.ts). Never cached, never indexed.
import Base from '../../layouts/Base.astro';
import ReviewAvatar from '../../components/ReviewAvatar.astro';
import { adminConfigured, isAdmin, logIn, logOut } from '../../lib/admin.ts';
import { approveReview, listReviews, rejectReview, removeReview, reviewsEnabled, ReviewError } from '../../lib/reviews.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

let loginFailed = false;
let actionError = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const id = String(form.get('id') ?? '');

  if (action === 'login') {
    if (!logIn(Astro.cookies, String(form.get('password') ?? ''))) {
      await new Promise((r) => setTimeout(r, 1000)); // slows down password guessing
      loginFailed = true;
    }
  } else if (action === 'logout') {
    logOut(Astro.cookies);
  } else if (isAdmin(Astro.cookies)) {
    try {
      if (action === 'approve') await approveReview(id);
      else if (action === 'reject') await rejectReview(id);
      else if (action === 'remove') await removeReview(id);
    } catch (err) {
      actionError = err instanceof ReviewError ? err.message : 'That didn’t work. Please try again.';
      if (!(err instanceof ReviewError)) console.error('Review action failed', err);
    }
  }
  // Post/redirect/get, so a refresh never repeats an approve or reject.
  if (!loginFailed && !actionError) return Astro.redirect('/admin/reviews', 303);
}

const enabled = reviewsEnabled();
const configured = adminConfigured();
const authed = isAdmin(Astro.cookies);
const [pending, approved] = enabled && authed ? await Promise.all([listReviews('pending'), listReviews('approved')]) : [[], []];
const when = (iso?: string) =>
  iso ? new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Africa/Harare' }) : '';
---

<Base metaTitle="Reviews admin – Byron Matsikembare" description="Approve reviews before they appear on the site." noindex>
  <section class="wrap pt-12 lg:pt-20 pb-20 lg:pb-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow">Admin</p>
        <h1 class="h-section mt-4">Reviews</h1>
      </div>
      {authed && (
        <form method="POST" class="flex items-center gap-6">
          <a href="/references" class="link-arrow">see them live</a>
          <button name="action" value="logout" class="text-[14px] text-muted underline underline-offset-4 hover:text-ink">Log out</button>
        </form>
      )}
    </div>

    {!configured ? (
      <div class="mt-10 max-w-[640px] text-[17px] leading-[1.7] text-ink">
        <p>The admin password isn't set. In Vercel, open the project's <strong>Settings → Environment Variables</strong>, add
        <code>REVIEWS_ADMIN_PASSWORD</code> (12 characters or more), then redeploy.</p>
      </div>
    ) : !authed ? (
      <form method="POST" class="mt-10 max-w-[400px] space-y-5">
        <input type="hidden" name="action" value="login" />
        <div>
          <label for="password" class="block text-[14px] text-ink mb-2">Password</label>
          <input id="password" name="password" type="password" required autocomplete="current-password" class="field" />
        </div>
        {loginFailed && <p class="text-[15px] text-ink border-l-2 border-accent pl-4" role="alert">That password isn't right.</p>}
        <button class="btn btn-primary">Log in</button>
      </form>
    ) : (
      <>
        {!enabled && (
          <p class="mt-10 max-w-[640px] text-[17px] leading-[1.7] text-ink border-l-2 border-accent pl-4">
            Review storage isn't connected. In Vercel, open <strong>Storage → Create → Blob</strong>, choose
            <strong>Private</strong>, connect it to this project, then redeploy.
          </p>
        )}
        {actionError && <p class="mt-10 text-[15px] text-ink border-l-2 border-accent pl-4" role="alert">{actionError}</p>}

        <h2 class="mt-14 text-[22px] font-normal text-ink">Waiting for you <span class="text-muted">{pending.length}</span></h2>
        {pending.length === 0 ? (
          <p class="mt-4 text-[16px] text-muted">Nothing to approve. You'll get an email when a new review comes in.</p>
        ) : (
          <ul class="mt-6 border-t border-line">
            {pending.map((r) => (
              <li class="py-8 border-b border-line">
                <div class="flex items-start gap-4">
                  <ReviewAvatar review={r} pending />
                  <div class="min-w-0">
                    <p class="text-[18px] text-ink">{r.name}</p>
                    <p class="text-[14px] text-muted">{[r.role, r.relationship].filter(Boolean).join(' · ')}</p>
                    <p class="mt-1 text-[13px] text-muted">
                      Sent {when(r.createdAt)}
                      {r.email && <> · <a href={`mailto:${r.email}`} class="underline underline-offset-4 hover:text-ink">{r.email}</a></>}
                    </p>
                  </div>
                </div>
                <blockquote class="mt-5 max-w-[760px] text-[17px] leading-[1.7] text-ink whitespace-pre-line border-l-2 border-line pl-5">{r.comment}</blockquote>
                <form method="POST" class="mt-6 flex flex-wrap items-center gap-3">
                  <input type="hidden" name="id" value={r.id} />
                  <button name="action" value="approve" class="btn btn-primary">Approve</button>
                  <button name="action" value="reject" class="btn btn-outline" data-confirm={`Delete ${r.name}'s review? This can't be undone.`}>Reject</button>
                </form>
              </li>
            ))}
          </ul>
        )}

        <h2 class="mt-16 text-[22px] font-normal text-ink">Live on the site <span class="text-muted">{approved.length}</span></h2>
        {approved.length === 0 ? (
          <p class="mt-4 text-[16px] text-muted">No approved reviews yet.</p>
        ) : (
          <ul class="mt-6 border-t border-line">
            {approved.map((r) => (
              <li class="py-6 border-b border-line flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center gap-4 min-w-0">
                  <ReviewAvatar review={r} size={44} />
                  <div class="min-w-0">
                    <p class="text-[16px] text-ink">{r.name}</p>
                    <p class="text-[13px] text-muted">Approved {when(r.approvedAt)}</p>
                  </div>
                </div>
                <form method="POST">
                  <input type="hidden" name="id" value={r.id} />
                  <button name="action" value="remove" class="text-[14px] text-muted underline underline-offset-4 hover:text-ink" data-confirm={`Take ${r.name}'s review off the site and delete it?`}>Remove</button>
                </form>
              </li>
            ))}
          </ul>
        )}
      </>
    )}
  </section>
</Base>

<style>
  .field {
    width: 100%;
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 12px 14px;
    font-size: 16px;
    font-weight: 300;
  }
  .field:focus { outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent; }
</style>

<script>
  // Ask before anything that deletes.
  document.querySelectorAll<HTMLButtonElement>('button[data-confirm]').forEach((button) =>
    button.addEventListener('click', (e) => {
      if (!confirm(button.dataset.confirm)) e.preventDefault();
    }),
  );
</script>
